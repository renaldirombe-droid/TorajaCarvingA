<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:strokeColor="@color/border_white"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (Dark Crimson) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D0A14"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnSpeak"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETAIL MOTIF"
                    android:textColor="@color/gold_accent"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NAMA MOTIF"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/tvDialogKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kategori"
                    android:textColor="@color/gold_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Tombol Speaker -->
            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bacakan"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/gold_accent" />
        </RelativeLayout>

        <!-- Body (Dark Background) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Gambar Motif -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/border_gold"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface_dark">

                <ImageView
                    android:id="@+id/ivDialogMotif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tedong"
                    android:contentDescription="Gambar Motif" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Makna Filosofi"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05" />

            <!-- ScrollView untuk Deskripsi -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tvDialogDeskripsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="Deskripsi motif akan muncul di sini."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.5" />
            </ScrollView>

            <!-- Tombol Detail -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogDetail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/gold_accent"
                android:text="Baca Penjelasan Lengkap"
                android:textColor="#000000"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

            <!-- Tombol Tutup -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogTutup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/primary_crimson"
                android:text="Tutup &amp; Lanjut Scan"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                app:cornerRadius="12dp"
                app:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
