<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Kamera PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bounding Box / Kotak Panduan Pemindaian Premium -->
    <View
        android:id="@+id/scannerFrame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/scanner_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutControlBawah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <!-- Teks Panduan Pemindaian -->
    <TextView
        android:id="@+id/textGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="Posisikan satu motif ukiran di dalam kotak"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_guideline_text"
        app:layout_constraintTop_toBottomOf="@id/scannerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Utilitas Atas -->
    <ImageButton
        android:id="@+id/btnSenter"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="24dp"
        android:padding="12dp"
        android:src="@drawable/ic_flash"
        app:tint="@color/gold_accent"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnBukaGaleri"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="24dp"
        android:padding="12dp"
        android:src="@drawable/ic_gallery"
        app:tint="@color/gold_accent"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Container Tombol Bawah (Mode Crop, Shutter, Debug) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutControlBawah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="12dp"
        android:paddingHorizontal="40dp"
        app:layout_constraintBottom_toTopOf="@id/cardHasil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Kiri: Tombol Mode Pindai -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCropMode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Kotak"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="16dp"
            android:backgroundTint="#4D000000"
            app:cornerRadius="24dp"
            app:strokeColor="#60FFD700"
            app:strokeWidth="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tengah: Tombol Shutter Capture (Disembunyikan sementara) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:visibility="gone"
            app:icon="@drawable/ic_menu_scan"
            app:iconTint="@color/white"
            app:iconSize="32dp"
            app:iconGravity="textStart"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="36dp"
            android:backgroundTint="@color/primary_crimson"
            app:strokeColor="@color/gold_accent"
            app:strokeWidth="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Kanan: Tombol Debug -->
        <ImageButton
            android:id="@+id/btnDebug"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_menu_info"
            app:tint="@color/gold_accent"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Indikator Peringatan Kamera -->
    <TextView
        android:id="@+id/textKameraWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_guideline_text"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text=""
        android:textColor="#FFCDD2"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutControlBawah"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hasil Klasifikasi Terapung (Glassmorphism) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/glass_darker"
        app:strokeColor="@color/border_white"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:animateLayoutChanges="true">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#40FFFFFF"
                android:layout_marginBottom="8dp" />

            <!-- Status Keyakinan -->
            <TextView
                android:id="@+id/textStatusKeyakinan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menganalisis..."
                android:textColor="@color/gold_accent"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="6dp" />

            <!-- Daftar Top 3 -->
            <LinearLayout
                android:id="@+id/layoutTop3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:animateLayoutChanges="true">

                <TextView
                    android:id="@+id/textTop1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/textTop2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/textTop3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLihatDetail"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:text="Lihat detail kandidat utama"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:visibility="gone"
                android:backgroundTint="@color/primary_crimson"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border_crimson"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>