<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:strokeColor="@color/border_white"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Badge Nomor -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/primary_crimson"
            app:strokeWidth="0dp"
            app:cardElevation="2dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvNomor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Informasi Nama & Tanggal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Motif"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvTanggalRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tanggal Scan"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>

        <!-- Ikon Sukses -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="@color/success_green"
            android:layout_marginStart="8dp"
            android:contentDescription="Terkonfirmasi" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
