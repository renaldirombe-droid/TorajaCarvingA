<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:strokeColor="@color/border_white"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Gambar Motif -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/border_gold"
            app:strokeWidth="1dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_dark">

            <ImageView
                android:id="@+id/ivGambarMotif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/tedong"
                android:contentDescription="Gambar Motif" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Informasi Teks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaMotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Motif"
                android:textColor="@color/gold_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvDeskripsiMotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Deskripsi singkat motif akan muncul di sini."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- Tombol Favorit -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/primary_crimson"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:contentDescription="Favorit" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
