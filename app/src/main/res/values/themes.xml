<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Neo-Modern Dark -->
    <style name="Base.Theme.TorajaCarvingAI" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_crimson</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Surface & Text -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Elevation Overlay (subtle dark) -->
        <item name="elevationOverlayEnabled">true</item>
    </style>

    <style name="Theme.TorajaCarvingAI" parent="Base.Theme.TorajaCarvingAI" />
</resources>
